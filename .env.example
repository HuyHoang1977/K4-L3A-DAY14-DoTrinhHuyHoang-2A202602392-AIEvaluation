# LLM backend for domain_assistant.py (system under evaluation).
# Copy this file to .env, then fill in ONE provider block.
# This file is git-ignored. Never commit or share it.

# Which provider to use: "gemini" or "openai".
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
# Verified working model: gemini-3.5-flash-lite
# Notes on the free tier: gemini-2.5-flash and gemini-2.5-flash-lite are refused
# for new accounts, and busy models return 503/429. List what your key can
# actually call with: python -c "from google import genai; ..."
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI ---
# Set LLM_PROVIDER=openai to switch back.
OPENAI_API_KEY=
OPENAI_MODEL=
